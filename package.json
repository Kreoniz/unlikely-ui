{
  "name": "unlikely-ui",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "A practical, expressive React design system built on Base UI and Tailwind CSS.",
  "license": "MIT",
  "author": "Kreoniz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kreoniz/unlikely-ui.git"
  },
  "bugs": "https://github.com/Kreoniz/unlikely-ui/issues",
  "homepage": "https://ui.kreoniz.ru",
  "keywords": [
    "react",
    "components",
    "design-system",
    "base-ui",
    "tailwindcss",
    "accessible"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "USAGE.md",
    "docs/components.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./alert": {
      "types": "./dist/components/alert.d.ts",
      "import": "./dist/components/alert.js"
    },
    "./badge": {
      "types": "./dist/components/badge.d.ts",
      "import": "./dist/components/badge.js"
    },
    "./button": {
      "types": "./dist/components/button.d.ts",
      "import": "./dist/components/button.js"
    },
    "./calendar": {
      "types": "./dist/components/calendar.d.ts",
      "import": "./dist/components/calendar.js"
    },
    "./card": {
      "types": "./dist/components/card.d.ts",
      "import": "./dist/components/card.js"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox.d.ts",
      "import": "./dist/components/checkbox.js"
    },
    "./combobox": {
      "types": "./dist/components/combobox.d.ts",
      "import": "./dist/components/combobox.js"
    },
    "./date-picker": {
      "types": "./dist/components/date-picker.d.ts",
      "import": "./dist/components/date-picker.js"
    },
    "./dialog": {
      "types": "./dist/components/dialog.d.ts",
      "import": "./dist/components/dialog.js"
    },
    "./field": {
      "types": "./dist/components/field.d.ts",
      "import": "./dist/components/field.js"
    },
    "./input": {
      "types": "./dist/components/input.d.ts",
      "import": "./dist/components/input.js"
    },
    "./physical-button": {
      "types": "./dist/components/physical-button.d.ts",
      "import": "./dist/components/physical-button.js"
    },
    "./popover": {
      "types": "./dist/components/popover.d.ts",
      "import": "./dist/components/popover.js"
    },
    "./radio-group": {
      "types": "./dist/components/radio-group.d.ts",
      "import": "./dist/components/radio-group.js"
    },
    "./scroll-area": {
      "types": "./dist/components/scroll-area.d.ts",
      "import": "./dist/components/scroll-area.js"
    },
    "./select": {
      "types": "./dist/components/select.d.ts",
      "import": "./dist/components/select.js"
    },
    "./skeleton": {
      "types": "./dist/components/skeleton.d.ts",
      "import": "./dist/components/skeleton.js"
    },
    "./spinner": {
      "types": "./dist/components/spinner.d.ts",
      "import": "./dist/components/spinner.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./textarea": {
      "types": "./dist/components/textarea.d.ts",
      "import": "./dist/components/textarea.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./toast": {
      "types": "./dist/components/toast.d.ts",
      "import": "./dist/components/toast.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tooltip": {
      "types": "./dist/components/tooltip.d.ts",
      "import": "./dist/components/tooltip.js"
    }
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "dev": "pnpm docs:generate && vite --host 127.0.0.1",
    "docs:generate": "node scripts/api-docs.mjs",
    "test:docs": "node --test tests/api-docs.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/token-types.mjs && pnpm docs:generate && tsc --noEmit",
    "build": "node scripts/build.mjs",
    "showcase:build": "pnpm docs:generate && vite build",
    "tokens:check": "python3 docs/foundations/build-sheet.py",
    "test:browser": "playwright test --project=showcase",
    "test:consumer": "node scripts/consumer.mjs",
    "release:check": "pnpm check && pnpm test:docs && pnpm tokens:check && pnpm showcase:build && pnpm test:browser && pnpm test:consumer",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm release:check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "react-day-picker": "10.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
